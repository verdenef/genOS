# genOS Repository Gitignore

# Ignore Obsidian workspace state
.obsidian/workspace*

# Binaries
*.exe

# Graphify code graph (rebuilt locally with `graphify extract . --code-only`)
graphify-out/

# Superpowers git worktrees
.worktrees/

# Ephemeral AI execution scratch, diff packages & local agent caches
.superpowers/
.claude/
*.tmp

# Python bytecode
__pycache__/
*.py[cod]

